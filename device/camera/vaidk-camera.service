[Unit]
Description=Vision AI DevKit camera (vaidk-camd)
# After init_display (the vendor's display server, for HDMI live view): at shutdown the camera stops first.
After=qmmf-server.service qmmf-webserver.service vaidk-rtsp.service init_display.service
Wants=qmmf-server.service vaidk-rtsp.service

[Service]
ExecStart=/bin/sh /opt/vaidk/camera/camd.sh
Restart=always
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
